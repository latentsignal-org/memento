# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# staged web UI embedded into the Go binary (generated by `pnpm stage:webui`)
/backend/internal/webui/dist/*
!/backend/internal/webui/dist/placeholder.html

# build outputs
/build
/memento
/backend/memento
/.gocache/

# misc
.DS_Store
*.pem
/.idea
/backend/.idea

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.sample
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

# data/ snapshots from *-pages CLI commands — not committed, use the live server instead
/data/*
!/data/.gitkeep

# pnpm temp junk (sandbox artifact; safe to delete)
_tmp_*
