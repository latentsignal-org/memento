{
  "name": "memento",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "stage:webui": "mkdir -p backend/internal/webui/dist && find backend/internal/webui/dist -mindepth 1 ! -name placeholder.html -delete && cp -R out/. backend/internal/webui/dist/",
    "build:backend": "cd backend && go build -o ../memento ./cmd/memento",
    "package": "pnpm build && pnpm stage:webui && pnpm build:backend",
    "app": "pnpm package && ./memento app",
    "demo": "pnpm package && ./memento app --demo",
    "lint": "eslint",
    "e2e:seed": "cd backend && GOCACHE=/tmp/memento-go-build go run ./cmd/e2e-fixture --db /tmp/memento-e2e.sqlite",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-sha256": "^0.11.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
